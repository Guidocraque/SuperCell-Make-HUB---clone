# =====================================================================
# CONFIGURAÇÃO DE AMBIENTE - SUPERCELL MAKE HUB (PEDIDOS DE PROPOSTA COM IA)
# =====================================================================

# GEMINI_API_KEY: Chave de API Google Gemini (usada apenas no backend)
# Obtida no Google AI Studio (https://aistudio.google.com/app/apikey).
# Injetada automaticamente em ambiente Google AI Studio através do painel Secrets.
GEMINI_API_KEY="AIzaSy..."

# GEMINI_MODEL: Modelo Gemini para interpretação estruturada de pedidos.
# Padrão recomendado: gemini-3.8-flash (alta precisão e quota gratuita disponível).
GEMINI_MODEL="gemini-3.8-flash"

# RESEND_API_KEY: Chave da API Resend para envio de notificações ao aluno (apenas backend).
# Criada em https://resend.com/api-keys.
RESEND_API_KEY="re_..."

# EMAIL_ALUNO: Endereço de email titular da conta Resend do aluno.
# O remetente de testes onboarding@resend.dev só autoriza envio para este email específico.
# Os clientes que preenchem o formulário NUNCA recebem emails.
EMAIL_ALUNO="o-seu-email-da-conta-resend@gmail.com"

# APP_BASE_URL: URL pública da aplicação para construção de links das propostas.
# Novo domínio: https://supercell-make-hub.ai.studio
APP_BASE_URL="https://supercell-make-hub.ai.studio"

# ADMIN_UID: Identificador único Firebase (UID) do aluno autorizado a aceder a /admin.
# Após fazer login com Google na área /admin, o sistema exibe o seu UID para copiar.
ADMIN_UID="substitua-pelo-seu-firebase-uid"
